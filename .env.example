# ============================================================
# Integração Conta Azul — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# ============================================================

# ------------------------------------------------------------
# Autenticação da aplicação (usuário único, sem banco de dados)
# ------------------------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Segredo usado para assinar o JWT do cookie de sessão.
# Gere com: openssl rand -base64 32
AUTH_JWT_SECRET=
# Duração da sessão (horas) após o login
AUTH_SESSION_TTL_HOURS=1

# ------------------------------------------------------------
# Dev server na rede local (Next.js 16)
# ------------------------------------------------------------
# Hosts adicionais autorizados no modo desenvolvimento (senão o Next 16
# responde 403 para /_next/static e /_next/hmr por Host cross-origin).
# Em WSL2 em modo espelhado, use o IP de LAN do Windows. Separe por vírgula.
ALLOWED_DEV_ORIGINS=192.168.1.23

# Credenciais OAuth2 da aplicação criada no Portal do Desenvolvedor
# (https://developers-portal.contaazul.com)
CA_CLIENT_ID=
CA_CLIENT_SECRET=

# URL de redirecionamento — deve ser IDÊNTICA à cadastrada no portal.
# Em uso pela rede local com WSL2: outras máquinas acessam o IP de LAN do
# Windows (não o do WSL). Em modo espelhado (.wslconfig), defina:
#
#   CA_REDIRECT_URI=http://IP-NA-REDE-LOCAL-DO-WINDOWS:3000/api/auth/callback
#
# • App de PRODUÇÃO: cadastre exatamente esta URL no portal do desenvolvedor.
# • App de DESENVOLVIMENTO: o Conta Azul NÃO aceita localhost. Use a URL fixa
#   do fluxo de dev, autorize, e cole o "?code=..." retornado na tela inicial
#   (botão "Código de autorização"):
#     CA_REDIRECT_URI=https://www.contaazul.com
CA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Escopos solicitados no fluxo OAuth2
CA_OAUTH_SCOPE=openid profile aws.cognito.signin.user.admin

# Endpoints da API Conta Azul (padrões oficiais — normalmente não precisa alterar)
# ATENÇÃO: valores com "#" exigem aspas, senão o parser do .env descarta o fragmento!
# Token endpoint conforme docs oficiais (developers.contaazul.com/changecode):
CA_API_BASE_URL=https://api-v2.contaazul.com
CA_AUTHORIZE_URL="https://login.contaazul.com/#/oauth/authorize"
CA_TOKEN_URL=https://api-v2.contaazul.com/oauth/token

# Intervalo (ms) entre chamadas de baixa no envio em lote, para respeitar rate limit
BAIXAS_REQUEST_DELAY_MS=300

# Tamanho de página ao listar contas financeiras (dropdown)
CONTAS_FINANCEIRAS_PAGE_SIZE=100

# Tamanho de página ao buscar lançamentos/eventos financeiros (dropdown)
EVENTOS_FINANCEIROS_PAGE_SIZE=200

# ------------------------------------------------------------
# Persistência dos tokens OAuth2 no Vercel (IMPORTANTE)
# ------------------------------------------------------------
# Em produção no Vercel (serverless), memória e arquivo `.cache/` NÃO persistem
# entre as instâncias cold-start — isso causa o erro "Não autenticado" no envio
# das baixas logo após buscar eventos/contas.
#
# Para resolver, configure um Vercel KV (Upstash Redis). No dashboard do Vercel
# (Storage → Create Database → KV), o projeto recebe automaticamente as
# variáveis KV_REST_API_URL e KV_REST_API_TOKEN. Se não aparecerem, copie do
# painel "REST API" do banco: Endpoint (URL) e Token.
#
# Sem KV em produção, o fluxo de baixas falhará com 401 intermitente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# TTL (segundos) da chave no KV; evita dados obsoletos. Padrão: 30 dias.
# CA_TOKENS_KV_TTL_SECONDS=2592000
